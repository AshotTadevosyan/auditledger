# Shell syntax. Copy to .env and run: set -a; source .env; set +a
AUDIT_DB_PATH=data/audit.sqlite3
# Leave blank to use a generated, private local key in data/secret.key.
AUDIT_SECRET_KEY=
AUDIT_TIME_ZONE=Asia/Yerevan
AUDIT_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Local mode is the default. Render always requires hosted mode.
AUDIT_MODE=local
# Hosted configuration (set through Render, not a committed .env):
# AUDIT_MODE=hosted
# AUDIT_SECRET_KEY=<at least 32 cryptographically random characters>
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB
# AUDIT_DB_SSLMODE=require
# AUDIT_ALLOWED_HOSTS=audit.example.com
# AUDIT_CSRF_TRUSTED_ORIGINS=https://audit.example.com
# Render's exact RENDER_EXTERNAL_HOSTNAME is added automatically.
